---
import '../styles/global.css';
import todosScreenshot from '../assets/todo-dark.png';
import workoutTrackerScreenshot from '../assets/workout-tracker-dark.png';
import chefScreenshot from '../assets/chef-dark.png';

const title = 'Every App';
const description = 'Make every app open source. Build what you want to exist. Share it easily with others. Self host unlimited apps on Cloudflare for $5/month';
const videoManifestUrl =
  'https://customer-30n86idll8ihv3ko.cloudflarestream.com/2382a24aad763613e4072c789e743759/manifest/video.m3u8';
const demoTimestamps = [
  { label: 'App Demos', time: '0:11', seconds: 11 },
  { label: 'Why Every App Exists', time: '0:40', seconds: 40 },
  { label: 'Self Host w/ 1 Command', time: '1:21', seconds: 81 },
  { label: 'Walkthrough: Workout Tracker', time: '2:37', seconds: 157 },
  { label: 'Gateway Architecture', time: '3:36', seconds: 216 },
  { label: 'Build an App', time: '5:46', seconds: 346 },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={String(description)} />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={String(description)} />
    <meta property="og:image" content="/OpenGraphPreview.png" />
    <meta property="og:image:alt" content="Every App - The open source personal software platform" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={String(description)} />
    <meta name="twitter:image" content="/OpenGraphPreview.png" />
    <meta name="twitter:image:alt" content="Every App - The open source personal software platform" />

    <!-- Preconnect to improve initial connection time -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/plyr@3.7.8/dist/plyr.css" />

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/manifest.json" />
  </head>
  <body>
    <div class="bg-[#0a0f0d]">
      <!-- Header -->
      <header class="absolute top-0 left-0 right-0 z-10 px-6 py-6">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
          <img
            src="/transparent-logo.png"
            alt="Every App Logo"
            class="w-12 h-12 opacity-80 hover:opacity-100 transition-opacity"
          />
          <nav class="flex items-center gap-6">
            <a 
	      href="/docs/introduction"
              class="text-white text-base font-medium hover:text-stone-300 transition-colors"
            >
              Docs
            </a>
            <a 
              href="https://discord.gg/c9uGs3cFXr"
              target="_blank"
              rel="noopener noreferrer"
              class="opacity-80 hover:opacity-100 transition-opacity"
              aria-label="Join our Discord"
            >
              <svg viewBox="0 0 256 199" width="24" height="24" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid">
                <path d="M216.856 16.597A208.502 208.502 0 0 0 164.042 0c-2.275 4.113-4.933 9.645-6.766 14.046-19.692-2.961-39.203-2.961-58.533 0-1.832-4.4-4.55-9.933-6.846-14.046a207.809 207.809 0 0 0-52.855 16.638C5.618 67.147-3.443 116.4 1.087 164.956c22.169 16.555 43.653 26.612 64.775 33.193A161.094 161.094 0 0 0 79.735 175.3a136.413 136.413 0 0 1-21.846-10.632 108.636 108.636 0 0 0 5.356-4.237c42.122 19.702 87.89 19.702 129.51 0a131.66 131.66 0 0 0 5.355 4.237 136.07 136.07 0 0 1-21.886 10.653c4.006 8.02 8.638 15.67 13.873 22.848 21.142-6.58 42.646-16.637 64.815-33.213 5.316-56.288-9.08-105.09-38.056-148.36ZM85.474 135.095c-12.645 0-23.015-11.805-23.015-26.18s10.149-26.2 23.015-26.2c12.867 0 23.236 11.804 23.015 26.2.02 14.375-10.148 26.18-23.015 26.18Zm85.051 0c-12.645 0-23.014-11.805-23.014-26.18s10.148-26.2 23.014-26.2c12.867 0 23.236 11.804 23.015 26.2 0 14.375-10.148 26.18-23.015 26.18Z" fill="white"/>
              </svg>
            </a>
            <a 
              href="https://github.com/every-app/every-app"
              target="_blank"
              rel="noopener noreferrer"
              class="opacity-80 hover:opacity-100 transition-opacity"
              aria-label="View on GitHub"
            >
              <svg width="24" height="24" viewBox="0 0 1024 1024" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8C0 11.54 2.29 14.53 5.47 15.59C5.87 15.66 6.02 15.42 6.02 15.21C6.02 15.02 6.01 14.39 6.01 13.72C4 14.09 3.48 13.23 3.32 12.78C3.23 12.55 2.84 11.84 2.5 11.65C2.22 11.5 1.82 11.13 2.49 11.12C3.12 11.11 3.57 11.7 3.72 11.94C4.44 13.15 5.59 12.81 6.05 12.6C6.12 12.08 6.33 11.73 6.56 11.53C4.78 11.33 2.92 10.64 2.92 7.58C2.92 6.71 3.23 5.99 3.74 5.43C3.66 5.23 3.38 4.41 3.82 3.31C3.82 3.31 4.49 3.1 6.02 4.13C6.66 3.95 7.34 3.86 8.02 3.86C8.7 3.86 9.38 3.95 10.02 4.13C11.55 3.09 12.22 3.31 12.22 3.31C12.66 4.41 12.38 5.23 12.3 5.43C12.81 5.99 13.12 6.7 13.12 7.58C13.12 10.65 11.25 11.33 9.47 11.53C9.76 11.78 10.01 12.26 10.01 13.01C10.01 14.08 10 14.94 10 15.21C10 15.42 10.15 15.67 10.55 15.59C13.71 14.53 16 11.53 16 8C16 3.58 12.42 0 8 0Z" transform="scale(64)" fill="white"/>
              </svg>
            </a>
          </nav>
        </div>
      </header>

      <!-- Hero Section -->
      <section class="relative min-h-[100svh] md:min-h-0 px-6 pt-32 pb-16 md:pt-36 md:pb-20">
        <div class="max-w-6xl mx-auto">
          <div class="max-w-2xl">
            <h1 class="text-[clamp(3rem,10vw,7rem)] font-bold text-white leading-none tracking-tight mb-6">
              EVERY APP
            </h1>

            <p class="text-[clamp(1.5rem,3vw,2rem)] text-white font-normal mb-6">
              Make every app open source
            </p>

            <div class="space-y-2 text-[clamp(1rem,2vw,1.25rem)] text-stone-400 font-light mb-10">
              <p>Build what you want to exist</p>
              <p>Share it easily with others</p>
              <p>Self host unlimited apps on Cloudflare for $5/month</p>
            </div>

            <p class="text-stone-500 text-sm mb-2">Self host with one command</p>
            <div class="bg-[#141a17] border border-stone-800 rounded-md px-3 py-2 inline-flex items-center gap-3">
              <code class="text-sm text-stone-300 font-mono">
                npx everyapp gateway deploy
              </code>
              <button
                id="copy-command"
                class="text-stone-500 hover:text-stone-300 transition-colors"
                aria-label="Copy command"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="copy-icon">
                  <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                  <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                </svg>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="check-icon hidden">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              </button>
            </div>
          </div>

          <div class="mt-20 md:mt-24">
            <div class="rounded-2xl border border-stone-800 overflow-hidden bg-[#090e0c]">
              <div class="demo-player-frame">
                <video id="everyapp-demo-player" class="block w-full h-auto" playsinline controls />
                <div class="demo-player-chapters" aria-label="Video timestamps">
                  {
                    demoTimestamps.map((entry) => (
                      <button
                        class="demo-chapter-button"
                        type="button"
                        data-seconds={entry.seconds}
                        title={`${entry.time} — ${entry.label}`}
                      >
                        <span class="demo-chapter-time">{entry.time}</span>
                        <span class="demo-chapter-label">{entry.label}</span>
                      </button>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>

          <script>
            const copyButton = document.getElementById('copy-command');
            const copyIcon = copyButton?.querySelector('.copy-icon');
            const checkIcon = copyButton?.querySelector('.check-icon');

            copyButton?.addEventListener('click', async () => {
              await navigator.clipboard.writeText('npx everyapp gateway deploy');
              copyIcon?.classList.add('hidden');
              checkIcon?.classList.remove('hidden');

              setTimeout(() => {
                copyIcon?.classList.remove('hidden');
                checkIcon?.classList.add('hidden');
              }, 2000);
            });
          </script>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.17/dist/hls.min.js" defer></script>
        <script src="https://cdn.jsdelivr.net/npm/plyr@3.7.8/dist/plyr.polyfilled.min.js" defer></script>
        <script define:vars={{ videoManifestUrl }}>
          const initializeDemoPlayer = () => {
            const playerElement = document.getElementById('everyapp-demo-player');

            if (!(playerElement instanceof HTMLVideoElement) || !window.Plyr) {
              return;
            }

            const player = new window.Plyr(playerElement, {
              controls: ['play-large', 'play', 'progress', 'current-time', 'mute', 'volume', 'captions', 'fullscreen'],
              captions: { active: false, language: 'auto', update: true },
            });

            if (window.Hls?.isSupported()) {
              const hls = new window.Hls();
              hls.loadSource(videoManifestUrl);
              hls.attachMedia(playerElement);
            } else {
              playerElement.src = videoManifestUrl;
            }

            const tryEnableCaptions = () => {
              const textTracks = Array.from(playerElement.textTracks ?? []);
              const firstSubtitleTrack = textTracks.find((track) => (
                track.kind === 'subtitles' || track.kind === 'captions'
              ));

              if (!firstSubtitleTrack) {
                return false;
              }

              textTracks.forEach((track) => {
                track.mode = track === firstSubtitleTrack ? 'showing' : 'disabled';
              });

              if (player.captions) {
                player.captions.active = true;
              }

              return true;
            };

            const enableCaptionsOnFirstPlay = () => {
              let attempts = 0;
              const maxAttempts = 12;
              const intervalId = window.setInterval(() => {
                attempts += 1;

                if (tryEnableCaptions() || attempts >= maxAttempts) {
                  window.clearInterval(intervalId);
                }
              }, 500);

              if (tryEnableCaptions()) {
                window.clearInterval(intervalId);
              }

              if (typeof player.off === 'function') {
                player.off('play', enableCaptionsOnFirstPlay);
              }
            };

            player.on('play', enableCaptionsOnFirstPlay);

            const chapterButtons = document.querySelectorAll('.demo-chapter-button');

            chapterButtons.forEach((button) => {
              button.addEventListener('click', () => {
                const seconds = Number(button.getAttribute('data-seconds') ?? '0');
                player.currentTime = seconds;
                void player.play();
              });
            });
          };

          window.addEventListener('load', initializeDemoPlayer);
        </script>
      </section>

      <!-- Section Divider -->
      <div class="px-16">
        <hr class="border-stone-800" />
      </div>

      <!-- What is Every App Section -->
      <section class="px-6 py-12 md:py-24">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-[clamp(2rem,5vw,3rem)] font-bold text-white mb-4">
            What is Every App?
          </h2>
          <div class="text-stone-400 text-lg max-w-3xl space-y-4">
            <p>
              Every App is a platform for self hosting apps. It standardizes how to build them on Cloudflare so that your apps scale to zero and also to infinity.
            </p>
            <p>
              It hoists common logic like authentication and user management to the Every App Gateway so that you don't need to triple check if your AI agent screwed that up.
            </p>
            <p>
              Every App's goal is to kickstart a community that builds a thousands of fun and powerful applications that are just as easy to use as any traditional consumer app or SaaS.
            </p>
          </div>
        </div>
      </section>

      <!-- Section Divider -->
      <div class="px-16">
        <hr class="border-stone-800" />
      </div>

      <!-- Stop Rebuilding Section -->
      <section class="px-6 py-12 md:py-24">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-[clamp(2rem,5vw,3rem)] font-bold text-white mb-4">
            Stop rebuilding the same stuff
          </h2>
          <p class="text-stone-400 text-lg mb-12 max-w-3xl">
            Every App handles the tedious parts of building new apps so you can focus on your idea.
          </p>
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Authentication -->
            <div class="bg-[#141a17] border border-stone-800 rounded-lg p-6">
              <div class="flex items-center gap-3 mb-3 md:block">
                <div class="w-9 h-9 md:w-10 md:h-10 bg-stone-800 rounded-lg flex items-center justify-center flex-shrink-0 md:mb-4">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stone-300 md:w-5 md:h-5">
                    <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                  </svg>
                </div>
                <h3 class="text-white font-semibold text-lg md:mb-2">Authentication</h3>
              </div>
              <p class="text-stone-400 text-sm">Users log in once to the Gateway. Your apps inherit auth automatically.</p>
            </div>

            <!-- User Management -->
            <div class="bg-[#141a17] border border-stone-800 rounded-lg p-6">
              <div class="flex items-center gap-3 mb-3 md:block">
                <div class="w-9 h-9 md:w-10 md:h-10 bg-stone-800 rounded-lg flex items-center justify-center flex-shrink-0 md:mb-4">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stone-300 md:w-5 md:h-5">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                  </svg>
                </div>
                <h3 class="text-white font-semibold text-lg md:mb-2">User Management</h3>
              </div>
              <p class="text-stone-400 text-sm">Add users to your Gateway. They instantly get access to all your apps.</p>
            </div>

            <!-- Database Setup -->
            <div class="bg-[#141a17] border border-stone-800 rounded-lg p-6">
              <div class="flex items-center gap-3 mb-3 md:block">
                <div class="w-9 h-9 md:w-10 md:h-10 bg-stone-800 rounded-lg flex items-center justify-center flex-shrink-0 md:mb-4">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stone-300 md:w-5 md:h-5">
                    <ellipse cx="12" cy="5" rx="9" ry="3"/>
                    <path d="M3 5V19A9 3 0 0 0 21 19V5"/>
                    <path d="M3 12A9 3 0 0 0 21 12"/>
                  </svg>
                </div>
                <h3 class="text-white font-semibold text-lg md:mb-2">Database Setup</h3>
              </div>
              <p class="text-stone-400 text-sm">Cloudflare D1 pre-configured. Just define your schema and go.</p>
            </div>

            <!-- Hosting & Deployment -->
            <div class="bg-[#141a17] border border-stone-800 rounded-lg p-6">
              <div class="flex items-center gap-3 mb-3 md:block">
                <div class="w-9 h-9 md:w-10 md:h-10 bg-stone-800 rounded-lg flex items-center justify-center flex-shrink-0 md:mb-4">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stone-300 md:w-5 md:h-5">
                    <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>
                  </svg>
                </div>
                <h3 class="text-white font-semibold text-lg md:mb-2">Hosting & Deployment</h3>
              </div>
              <p class="text-stone-400 text-sm">One CLI command deploys to Cloudflare. Scales to zero, starts free.</p>
            </div>

            <!-- AI Agent Context -->
            <div class="bg-[#141a17] border border-stone-800 rounded-lg p-6">
              <div class="flex items-center gap-3 mb-3 md:block">
                <div class="w-9 h-9 md:w-10 md:h-10 bg-stone-800 rounded-lg flex items-center justify-center flex-shrink-0 md:mb-4">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stone-300 md:w-5 md:h-5">
                    <path d="M12 8V4H8"/>
                    <rect width="16" height="12" x="4" y="8" rx="2"/>
                    <path d="M2 14h2"/>
                    <path d="M20 14h2"/>
                    <path d="M15 13v2"/>
                    <path d="M9 13v2"/>
                  </svg>
                </div>
                <h3 class="text-white font-semibold text-lg md:mb-2">Agent First</h3>
              </div>
              <p class="text-stone-400 text-sm">MCP server gives your coding agent full example apps to reference.</p>
            </div>

            <!-- Patterns That Scale -->
            <div class="bg-[#141a17] border border-stone-800 rounded-lg p-6">
              <div class="flex items-center gap-3 mb-3 md:block">
                <div class="w-9 h-9 md:w-10 md:h-10 bg-stone-800 rounded-lg flex items-center justify-center flex-shrink-0 md:mb-4">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stone-300 md:w-5 md:h-5">
                    <polygon points="12 2 2 7 12 12 22 7 12 2"/>
                    <polyline points="2 17 12 22 22 17"/>
                    <polyline points="2 12 12 17 22 12"/>
                  </svg>
                </div>
                <h3 class="text-white font-semibold text-lg md:mb-2">Patterns That Scale</h3>
              </div>
              <p class="text-stone-400 text-sm">Well-defined patterns for your agent to follow.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section Divider -->
      <div class="px-16">
        <hr class="border-stone-800" />
      </div>

      <!-- One Place Section -->
      <section class="px-6 py-12 md:py-24">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-[clamp(2rem,5vw,3rem)] font-bold text-white mb-4">
            One place for all your apps
          </h2>
          <p class="text-stone-400 text-lg mb-12 max-w-3xl">
            The Gateway is your personal app hub. Manage and access everything from a single URL.
          </p>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Single URL -->
            <div class="bg-[#141a17] border border-stone-800 rounded-lg p-6">
              <div class="flex items-center gap-3 mb-3 md:block">
                <div class="w-9 h-9 md:w-10 md:h-10 bg-stone-800 rounded-lg flex items-center justify-center flex-shrink-0 md:mb-4">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stone-300 md:w-5 md:h-5">
                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                  </svg>
                </div>
                <h3 class="text-white font-semibold text-lg md:mb-2">Single URL</h3>
              </div>
              <p class="text-stone-400 text-sm">Go to your Gateway. Access all your apps.</p>
            </div>

            <!-- Mobile Optimized -->
            <div class="bg-[#141a17] border border-stone-800 rounded-lg p-6">
              <div class="flex items-center gap-3 mb-3 md:block">
                <div class="w-9 h-9 md:w-10 md:h-10 bg-stone-800 rounded-lg flex items-center justify-center flex-shrink-0 md:mb-4">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stone-300 md:w-5 md:h-5">
                    <rect width="14" height="20" x="5" y="2" rx="2" ry="2"/>
                    <path d="M12 18h.01"/>
                  </svg>
                </div>
                <h3 class="text-white font-semibold text-lg md:mb-2">Mobile Optimized</h3>
              </div>
              <p class="text-stone-400 text-sm">Add Gateway to your home screen once. All apps get the mobile PWA benefits. Native mobile (and Roku) apps coming soon.</p>
            </div>

            <!-- No Auth Per App -->
            <div class="bg-[#141a17] border border-stone-800 rounded-lg p-6">
              <div class="flex items-center gap-3 mb-3 md:block">
                <div class="w-9 h-9 md:w-10 md:h-10 bg-stone-800 rounded-lg flex items-center justify-center flex-shrink-0 md:mb-4">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stone-300 md:w-5 md:h-5">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
                    <path d="m9 12 2 2 4-4"/>
                  </svg>
                </div>
                <h3 class="text-white font-semibold text-lg md:mb-2">Simplified Auth</h3>
              </div>
              <p class="text-stone-400 text-sm">Apps inherit authentication from the Gateway. Deploy new apps faster than it takes to Login with Google.</p>
            </div>

            <!-- LLM Gateway Coming Soon -->
            <div class="bg-[#141a17] border border-stone-800 rounded-lg p-6">
              <div class="flex items-center gap-3 mb-3 md:block">
                <div class="w-9 h-9 md:w-10 md:h-10 bg-stone-800 rounded-lg flex items-center justify-center flex-shrink-0 md:mb-4">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-stone-300 md:w-5 md:h-5">
                    <path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 4.44-1.54"/>
                    <path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-4.44-1.54"/>
                  </svg>
                </div>
                <h3 class="text-white font-semibold text-lg md:mb-2">LLM Gateway <span class="text-stone-500 text-sm font-normal">(Coming Soon)</span></h3>
              </div>
              <p class="text-stone-400 text-sm">Configure your AI provider once. Set per-app budgets. No more scattered API keys.</p>
