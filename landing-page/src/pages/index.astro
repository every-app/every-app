      <!-- Example Apps Section -->
      <section class="px-6 py-12 md:py-24">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-[clamp(2rem,5vw,3rem)] font-bold text-white mb-4">
             App Examples
          </h2>
          <p class="text-stone-400 text-lg mb-12 max-w-2xl">
	  Deploy these open source apps with one command. Tell your agent to reference their code with our MCP. 
          </p>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Todo App -->
            <button class="bg-[#141a17] border border-stone-800 rounded-lg overflow-hidden text-left cursor-pointer hover:border-stone-700 transition-colors" data-preview={todosScreenshot.src} data-alt="Todo App Screenshot">
              <div class="aspect-video bg-stone-900 flex items-center justify-center">
                <img src={todosScreenshot.src} alt="Todo App Screenshot" class="h-full object-contain" loading="lazy" />
              </div>
              <div class="p-6">
                <h3 class="text-white font-semibold text-lg mb-2">Todo App</h3>
                <p class="text-stone-400 text-sm">A minimal todo list with sync across your devices and keyboard navigation.</p>
              </div>
            </button>

            <!-- Workout Tracker -->
            <button class="bg-[#141a17] border border-stone-800 rounded-lg overflow-hidden text-left cursor-pointer hover:border-stone-700 transition-colors" data-preview={workoutTrackerScreenshot.src} data-alt="Workout Tracker Screenshot">
              <div class="aspect-video bg-stone-900 flex items-center justify-center">
                <img src={workoutTrackerScreenshot.src} alt="Workout Tracker Screenshot" class="h-full object-contain" loading="lazy" />
              </div>
              <div class="p-6">
                <h3 class="text-white font-semibold text-lg mb-2">Workout Tracker</h3>
                <p class="text-stone-400 text-sm">Mobile optimized. Track your workouts, programs, and progress over time.</p>
              </div>
            </button>

            <!-- Cooking Assistant -->
            <button class="bg-[#141a17] border border-stone-800 rounded-lg overflow-hidden text-left cursor-pointer hover:border-stone-700 transition-colors" data-preview={chefScreenshot.src} data-alt="Cooking Assistant Screenshot">
              <div class="aspect-video bg-stone-900 flex items-center justify-center">
                <img src={chefScreenshot.src} alt="Cooking Assistant Screenshot" class="h-full object-contain" loading="lazy" />
              </div>
              <div class="p-6">
                <h3 class="text-white font-semibold text-lg mb-2">Cooking Assistant</h3>
                <p class="text-stone-400 text-sm">An AI-powered cooking assistant and recipe manager.</p>
              </div>
            </button>
          </div>
          
          <!-- Image Preview Modal -->
          <div id="image-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm">
            <div class="relative w-full max-w-4xl max-h-[66vh] m-auto">
              <button id="modal-close" class="absolute -top-10 right-0 text-white/60 hover:text-white transition-colors" aria-label="Close preview">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 6 6 18M6 6l12 12"/>
                </svg>
              </button>
              <img id="modal-image" src="" alt="" class="w-full h-full object-contain rounded-lg" />
            </div>
          </div>
          
          <script>
            const modal = document.getElementById('image-modal');
            const modalImage = document.getElementById('modal-image') as HTMLImageElement;
            const modalClose = document.getElementById('modal-close');
            const previewButtons = document.querySelectorAll('[data-preview]');
            
            previewButtons.forEach(button => {
              button.addEventListener('click', () => {
                const src = button.getAttribute('data-preview');
                const alt = button.getAttribute('data-alt');
                if (src && modalImage) {
                  modalImage.src = src;
                  modalImage.alt = alt || '';
                  modal?.classList.remove('hidden');
                  modal?.classList.add('flex');
                  document.body.style.overflow = 'hidden';
                }
              });
            });
            
            function closeModal() {
              modal?.classList.add('hidden');
              modal?.classList.remove('flex');
              document.body.style.overflow = '';
            }
            
            modalClose?.addEventListener('click', closeModal);
            modal?.addEventListener('click', (e) => {
              if (e.target === modal) closeModal();
            });
            document.addEventListener('keydown', (e) => {
              if (e.key === 'Escape') closeModal();
            });
          </script>
        </div>
      </section>

      <!-- Section Divider -->
      <div class="px-16">
        <hr class="border-stone-800" />
      </div>

      <!-- Quick Start Section -->
      <section class="px-6 py-12 md:py-24">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-[clamp(2rem,5vw,3rem)] font-bold text-white mb-4">
            Get Started
          </h2>
          <p class="text-stone-400 text-lg mb-8">
            Deploy your own Gateway to Cloudflare in one command.
          </p>
          
          <div class="bg-[#141a17] border border-stone-800 rounded-md px-3 py-2 mb-6 inline-flex items-center gap-3">
            <code class="text-sm text-stone-300 font-mono">
              npx everyapp gateway deploy
            </code>
            <button 
              id="copy-command-bottom"
              class="text-stone-500 hover:text-stone-300 transition-colors"
              aria-label="Copy command"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="copy-icon-bottom">
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
              </svg>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="check-icon-bottom hidden">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </button>
          </div>
          
          <script>
            const copyButtonBottom = document.getElementById('copy-command-bottom');
            const copyIconBottom = copyButtonBottom?.querySelector('.copy-icon-bottom');
            const checkIconBottom = copyButtonBottom?.querySelector('.check-icon-bottom');
            
            copyButtonBottom?.addEventListener('click', async () => {
              await navigator.clipboard.writeText('npx everyapp gateway deploy');
              copyIconBottom?.classList.add('hidden');
              checkIconBottom?.classList.remove('hidden');
              
              setTimeout(() => {
                copyIconBottom?.classList.remove('hidden');
                checkIconBottom?.classList.add('hidden');
              }, 2000);
            });
          </script>
          
          <div>
            <a 
              href="/docs/introduction"
              class="inline-flex items-center gap-2 text-stone-400 hover:text-white transition-colors underline underline-offset-4 decoration-stone-600 hover:decoration-stone-400"
            >
              Read the Docs
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      </section>

