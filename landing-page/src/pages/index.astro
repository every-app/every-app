---
import '../styles/global.css';
import LinkCard from '../components/LinkCard.astro';
import gatewayScreenshot from '../assets/gateway-screenshot.png';
import todoScreenshot from '../assets/todo-screenshot.png';

const title = 'Every App';
const description = 'Make every app open source. No subscriptions or paywalls. Own your data. Share with the world.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={String(description)} />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={String(description)} />
    <meta property="og:image" content="/OpenGraphPreview.png" />
    <meta property="og:image:alt" content="Every App - Make every app open source" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={String(description)} />
    <meta name="twitter:image" content="/OpenGraphPreview.png" />
    <meta name="twitter:image:alt" content="Every App - Make every app open source" />

    <!-- Preconnect to improve initial connection time -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/manifest.json" />
  </head>
  <body>
    <div class="min-h-screen bg-[#0a0f0d]">
      <!-- Header -->
      <header class="absolute top-0 left-0 right-0 z-10 px-6 py-6">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
          <img
            src="/transparent-logo.png"
            alt="Every App Logo"
            class="w-12 h-12 opacity-80 hover:opacity-100 transition-opacity"
          />
          <nav class="flex items-center gap-6">
            <a 
	      href="/docs/introduction"
              class="text-white text-base font-medium hover:text-stone-300 transition-colors"
            >
              Docs
            </a>
            <a 
              href="https://discord.gg/c9uGs3cFXr"
              target="_blank"
              rel="noopener noreferrer"
              class="opacity-80 hover:opacity-100 transition-opacity"
              aria-label="Join our Discord"
            >
              <svg viewBox="0 0 256 199" width="24" height="24" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid">
                <path d="M216.856 16.597A208.502 208.502 0 0 0 164.042 0c-2.275 4.113-4.933 9.645-6.766 14.046-19.692-2.961-39.203-2.961-58.533 0-1.832-4.4-4.55-9.933-6.846-14.046a207.809 207.809 0 0 0-52.855 16.638C5.618 67.147-3.443 116.4 1.087 164.956c22.169 16.555 43.653 26.612 64.775 33.193A161.094 161.094 0 0 0 79.735 175.3a136.413 136.413 0 0 1-21.846-10.632 108.636 108.636 0 0 0 5.356-4.237c42.122 19.702 87.89 19.702 129.51 0a131.66 131.66 0 0 0 5.355 4.237 136.07 136.07 0 0 1-21.886 10.653c4.006 8.02 8.638 15.67 13.873 22.848 21.142-6.58 42.646-16.637 64.815-33.213 5.316-56.288-9.08-105.09-38.056-148.36ZM85.474 135.095c-12.645 0-23.015-11.805-23.015-26.18s10.149-26.2 23.015-26.2c12.867 0 23.236 11.804 23.015 26.2.02 14.375-10.148 26.18-23.015 26.18Zm85.051 0c-12.645 0-23.014-11.805-23.014-26.18s10.148-26.2 23.014-26.2c12.867 0 23.236 11.804 23.015 26.2 0 14.375-10.148 26.18-23.015 26.18Z" fill="white"/>
              </svg>
            </a>
            <a 
              href="https://github.com/every-app/every-app"
              target="_blank"
              rel="noopener noreferrer"
              class="opacity-80 hover:opacity-100 transition-opacity"
              aria-label="View on GitHub"
            >
              <svg width="24" height="24" viewBox="0 0 1024 1024" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8C0 11.54 2.29 14.53 5.47 15.59C5.87 15.66 6.02 15.42 6.02 15.21C6.02 15.02 6.01 14.39 6.01 13.72C4 14.09 3.48 13.23 3.32 12.78C3.23 12.55 2.84 11.84 2.5 11.65C2.22 11.5 1.82 11.13 2.49 11.12C3.12 11.11 3.57 11.7 3.72 11.94C4.44 13.15 5.59 12.81 6.05 12.6C6.12 12.08 6.33 11.73 6.56 11.53C4.78 11.33 2.92 10.64 2.92 7.58C2.92 6.71 3.23 5.99 3.74 5.43C3.66 5.23 3.38 4.41 3.82 3.31C3.82 3.31 4.49 3.1 6.02 4.13C6.66 3.95 7.34 3.86 8.02 3.86C8.7 3.86 9.38 3.95 10.02 4.13C11.55 3.09 12.22 3.31 12.22 3.31C12.66 4.41 12.38 5.23 12.3 5.43C12.81 5.99 13.12 6.7 13.12 7.58C13.12 10.65 11.25 11.33 9.47 11.53C9.76 11.78 10.01 12.26 10.01 13.01C10.01 14.08 10 14.94 10 15.21C10 15.42 10.15 15.67 10.55 15.59C13.71 14.53 16 11.53 16 8C16 3.58 12.42 0 8 0Z" transform="scale(64)" fill="white"/>
              </svg>
            </a>
          </nav>
        </div>
      </header>

      <!-- Hero Section -->
      <section class="relative min-h-screen px-6 flex items-center justify-center">
        <div class="max-w-2xl mx-auto">
          <h1 class="text-[clamp(3rem,10vw,7rem)] font-bold text-white leading-none tracking-tight mb-6">
            EVERY APP
          </h1>

          <p class="text-[clamp(1.5rem,3vw,2rem)] text-white font-normal mb-6">
            Make every app open source.
          </p>

          <div class="space-y-2 text-[clamp(1rem,2vw,1.25rem)] text-stone-400 font-light">
            <p>No subscriptions or paywalls.</p>
            <p>Unleash your creativity.</p>
            <p>Personal software you can share with the world.</p>
          </div>
        </div>

        <!-- Scroll Indicator -->
        <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 mb-[env(safe-area-inset-bottom)]">
          <svg
            class="w-6 h-6 text-stone-500"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-label="Scroll down indicator"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"
            />
          </svg>
        </div>
      </section>

      <section class="py-12 px-6 border-t border-stone-800">
        <div class="max-w-2xl mx-auto">
          <h2 class="text-[clamp(1.5rem,4vw,2.5rem)] font-bold text-white mb-6">
            Philosophy
          </h2>
          <div class="pb-4 border-b border-stone-800">
            <p class="text-[clamp(1rem,2vw,1.25rem)] text-stone-300 font-light leading-relaxed">
              The best apps are made with love by people who use them.
            </p>
          </div>
          <div class="pt-4 pb-4 border-b border-stone-800">
            <p class="text-[clamp(1rem,2vw,1.25rem)] text-stone-300 font-light leading-relaxed">
              Apps solving common problems should be free.
            </p>
          </div>
          <div class="pt-4 pb-4 border-b border-stone-800">
            <p class="text-[clamp(1rem,2vw,1.25rem)] text-stone-300 font-light leading-relaxed">
              The best possible cooking app will not be a good business.
            </p>
          </div>
          <div class="pt-4 pb-4">
            <p class="text-[clamp(1rem,2vw,1.25rem)] text-stone-300 font-light leading-relaxed">
              Open source apps will be 10x better quality and result in more
              interesting applications.
            </p>
          </div>
        </div>
      </section>

      <section class="py-12 px-6 border-t border-stone-800">
        <div class="max-w-2xl mx-auto">
          <h2 class="text-[clamp(1.5rem,4vw,2.5rem)] font-bold text-white mb-6">
            Make any app
          </h2>
          <div class="space-y-6 text-[clamp(1rem,2vw,1.25rem)] text-stone-300 font-light leading-relaxed">
	  <p>
	  The coolest part about Every App is that you can make almost anything and host it for free.
	  </p>
	  <p>It makes using Cloudflare's diverse set of cloud services easy. Make anything from useful tools for yourself or your business, to fun games for your friends and family. 
          </p>
	  </div>
          <div class="mt-8 flex flex-col md:flex-row justify-center items-center gap-4 md:gap-8">
            <div class="mockup-phone border-stone-700 max-w-xs">
              <div class="mockup-phone-camera"></div>
              <div class="mockup-phone-display">
                <div class="w-full">
                  <img src={gatewayScreenshot.src} alt="Every App Gateway interface showing app management" class="brightness-75" />
                </div>
              </div>
            </div>
            <div class="mockup-phone border-stone-700 max-w-xs">
              <div class="mockup-phone-camera"></div>
              <div class="mockup-phone-display">
                <div class="w-full">
                  <img src={todoScreenshot.src} alt="Todo App interface demonstrating embedded app functionality" class="brightness-75" />
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="py-12 px-6 border-t border-stone-800">
        <div class="max-w-2xl mx-auto">
          <h2 class="text-[clamp(1.5rem,4vw,2.5rem)] font-bold text-white mb-6">
            How does it work?
          </h2>
          <div class="space-y-6 text-[clamp(1rem,2vw,1.25rem)] text-stone-300 font-light leading-relaxed">
            <p>
              Every App is a framework for building self hosted, full stack
              web applications.
            </p>
            <p>
	    It standardizes how to build these web apps and deploy them on Cloudflare. Cloudflare has a unique cloud offering of serverless functions, databases and containers which are pay by usage instead of fixed monthly prices enabling this simple and "free" hosting.
	    </p>
	    <p>
	    These can be apps solving a personal problem or a fun project to show off your skills in a portfolio. 
            </p>
            <p>
	    When you build something, you can can share it with others and they can easily use your app in their Gateway with one CLI command. As the framework and ecosystem mature, using new open source, full stack apps will be as easy as clicking "Install" in an App Store.
            </p>
          </div>
        </div>
      </section>

      <section class="py-12 px-6 border-t border-stone-800">
        <div class="max-w-2xl mx-auto">
          <h2 class="text-[clamp(1.5rem,4vw,2.5rem)] font-bold text-white mb-6">
            Why should you try Every App?
          </h2>
          <div class="space-y-8">
            <div class="pb-6 border-b border-stone-800">
              <h3 class="text-[clamp(1.25rem,2.5vw,1.75rem)] font-semibold text-white mb-3">
                For the community
              </h3>
              <p class="text-[clamp(1rem,2vw,1.25rem)] text-stone-300 font-light leading-relaxed">
	      Be part of a group of people who love to build for the sake of it. Learn from others experiences and read the code of other apps. This can be a place you meet friends, find jobs, or find co-founders for future ventures.
              </p>
            </div>
            <div class="pb-6 border-b border-stone-800">
              <h3 class="text-[clamp(1.25rem,2.5vw,1.75rem)] font-semibold text-white mb-3">
                For your resume
              </h3>
              <p class="text-[clamp(1rem,2vw,1.25rem)] text-stone-300 font-light leading-relaxed">
                Having a project you're passionate about is the best way to differentiate yourself in the job hunt and interviews. Every App is aiming to be the easiest way to build, deploy and share your passion projects.
              </p>
            </div>
            
            <div class="pb-6 border-b border-stone-800">
              <h3 class="text-[clamp(1.25rem,2.5vw,1.75rem)] font-semibold text-white mb-3">
                To learn how to start a company
              </h3>
              <p class="text-[clamp(1rem,2vw,1.25rem)] text-stone-300 font-light leading-relaxed">
                Building a product is a key skill in company building. Get experience rapidly building and marketing products through Every App without being bogged down by the unsexy parts of starting a company like billing, scalability, and legal.
              </p>
            </div>
            
            <div>
              <h3 class="text-[clamp(1.25rem,2.5vw,1.75rem)] font-semibold text-white mb-3">
                For yourself
              </h3>
              <p class="text-[clamp(1rem,2vw,1.25rem)] text-stone-300 font-light leading-relaxed">
                Solve your own problems with the help of the community and have a central, free place for your side projects without duct taping together a bunch of services trying to upcharge you.
              </p>
            </div>
            
          </div>
        </div>
      </section>

      <!-- Get Involved Section -->
      <section class="py-12 px-6 border-t border-stone-800">
        <div class="max-w-2xl mx-auto">
          <h2 class="text-[clamp(1.5rem,4vw,2.5rem)] font-bold text-white mb-6">
            Get involved
          </h2>
          <div class="space-y-6 text-[clamp(1rem,2vw,1.25rem)] text-stone-300 font-light leading-relaxed">
	  <p>Try deploying the Gateway yourself following the "Quickstart" guide! This will give you a feel for what Every App actually is and inspire ideas for what you can build.</p>
	  <p>Then, make sure to join the <a href="https://discord.gg/c9uGs3cFXr" target="_blank" rel="noopener noreferrer" class="text-white underline hover:text-stone-200 transition-colors">Discord</a> which is the place you can go when you're stuck or to talk through ideas before you build them.</p>
	  <LinkCard title="Quickstart" href="/docs/getting-started/quickstart" description="(5 minutes) Deploy the Every App Gateway and a Todo App" />
	  </div>
        </div>
      </section>

      <!-- Footer -->
      <footer class="py-12 px-6 border-t border-stone-800">
        <div class="max-w-2xl mx-auto">
          <p class="text-stone-400 text-base text-center">
            Make every app open source.
          </p>
        </div>
      </footer>
    </div>
  </body>
</html>
