---
export interface Props {
  title: string;
  href: string;
  description?: string;
}

const { title, href, description } = Astro.props;
---

<a 
  href={href} 
  class="link-card block p-6 bg-[#1a1f1e] rounded-lg border border-stone-700 hover:border-stone-500 transition-all hover:bg-[#232928] no-underline"
>
  <div class="flex items-start justify-between gap-4">
    <div class="flex-1">
      <h3 class="text-white font-semibold text-lg mb-2">
        {title}
      </h3>
      {description && (
        <p class="text-stone-400 text-base">
          {description}
        </p>
      )}
    </div>
    <svg 
      class="w-5 h-5 text-stone-500 flex-shrink-0 mt-1"
      fill="none" 
      stroke="currentColor" 
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path 
        stroke-linecap="round" 
        stroke-linejoin="round" 
        stroke-width="2" 
        d="M9 5l7 7-7 7"
      />
    </svg>
  </div>
</a>

<style>
  .link-card {
    text-decoration: none !important;
  }
  
  .link-card h3 {
    margin: 0 0 0.5rem 0;
  }
  
  .link-card p {
    margin: 0;
    line-height: 1.5;
  }
</style>