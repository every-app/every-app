{
  "name": "landing-page",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=every-app-landing-page",
    "types:check": "astro sync && tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "knip": "knip"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/starlight": "^0.29.3",
    "@astrojs/tailwind": "^5.1.2",
    "astro": "^4.16.18",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "knip": "^5.69.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.4"
  }
}
