{
  "name": "landing-page",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && astro check && astro build && node scripts/generate-sitemap.js",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=every-app-landing-page",
    "types:check": "astro sync && tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "knip": "knip",
    "llms-txt:generate": "node scripts/generate-llms-txt.js",
    "llms-txt:check": "node scripts/generate-llms-txt.js --check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/starlight": "^0.29.3",
    "@astrojs/tailwind": "^5.1.2",
    "astro": "^4.16.18",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "daisyui": "^5.5.5",
    "knip": "^5.69.1",
    "prettier": "^3.6.2",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.4"
  }
}
