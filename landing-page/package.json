{
  "name": "landing-page",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "node scripts/sync-agent-docs.js && vite dev",
    "sync:agent-docs": "node scripts/sync-agent-docs.js",
    "build": "node scripts/sync-agent-docs.js && wrangler types && vite build && node scripts/generate-sitemap.js",
    "sitemap": "node scripts/generate-sitemap.js",
    "preflight": "node scripts/preflight.js",
    "types:check": "wrangler types && tsc --noEmit",
    "cf-typegen": "wrangler types",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "deploy": "npm run build && wrangler deploy",
    "deploy:redirect": "wrangler deploy -c redirect/wrangler.jsonc"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.168.60",
    "fumadocs-core": "^16.17.3",
    "fumadocs-mdx": "^15.4.7",
    "fumadocs-ui": "^16.17.3",
    "lucide-react": "^0.563.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "prettier": "^3.6.2",
    "srvx": "^0.11.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.0.5",
    "wrangler": "^4.67.0"
  }
}
