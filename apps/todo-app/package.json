{
  "name": "todo-app",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "preview": "npm run build && vite preview --port 3001",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "types:check": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier . --write",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "drizzle-kit migrate",
    "db:migrate:prod": "every app remote-d1-shell -- drizzle-kit migrate --config=drizzle-prod.config.ts",
    "db:studio:local": "drizzle-kit studio",
    "db:studio:prod": "every app remote-d1-shell -- drizzle-kit studio --config=drizzle-prod.config.ts",
    "knip": "knip"
  },
  "dependencies": {
    "@every-app/sdk": "^0.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@tanstack/query-core": "^5.90.9",
    "@tanstack/query-db-collection": "^1.0.0",
    "@tanstack/react-db": "^0.1.44",
    "@tanstack/react-query": "^5.90.9",
    "@tanstack/react-router": "^1.136.3",
    "@tanstack/react-router-devtools": "^1.136.3",
    "@tanstack/react-start": "^1.136.3",
    "cloudflare": "^5.2.0",
    "daisyui": "^5.5.5",
    "drizzle-orm": "^0.44.4",
    "sonner": "^2.0.7",
    "jose": "^6.0.12",
    "lucide-react": "^0.542.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.17",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.18",
    "@cloudflare/workers-types": "^4.20251014.0",
    "@libsql/client": "^0.15.15",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.18.13",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.6.0",
    "drizzle-kit": "^0.31.4",
    "knip": "^5.66.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "wrangler": "^4.45.3"
  }
}
