{
  "name": "todo-app",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "everyapp dev",
    "dev:vite": "cf dev",
    "build": "vite build --mode development && tsc --noEmit",
    "deploy": "everyapp app deploy",
    "test": "vitest run --silent",
    "test:watch": "vitest",
    "types:check": "cf workers types && tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier . --write",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "everyapp app d1 migrate --local",
    "db:studio:local": "drizzle-kit studio",
    "knip": "knip"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@every-app/sdk": "workspace:*",
    "@tanstack/query-sync-storage-persister": "^5.90.14",
    "@tanstack/react-query": "^5.90.9",
    "@tanstack/react-query-persist-client": "^5.90.14",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "1.168.61",
    "@tiptap/core": "^3.20.0",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "daisyui": "^5.5.5",
    "drizzle-orm": "^0.45.3",
    "framer-motion": "^12.24.7",
    "jose": "^6.2.12",
    "lucide-react": "^0.542.0",
    "react": "^19.0.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.0.0",
    "react-hotkeys-hook": "^5.2.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.17",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-91c870c02",
    "@cloudflare/workers-types": "^4.20251014.0",
    "@libsql/client": "^0.15.15",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.18.13",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.6.0",
    "cf": "1.0.0-beta.14",
    "drizzle-kit": "^0.31.11",
    "everyapp": "workspace:*",
    "knip": "^5.66.4",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
