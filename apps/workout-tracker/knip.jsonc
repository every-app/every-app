{
  "entry": [
    // Detect Tanstack Start Routes
    "src/router.tsx",
    "src/routes/**/*.tsx",
    // v2 manifest consumed by the Every App CLI at build/deploy time
    "everyapp.config.ts",
  ],
  "project": ["**/*.{js,ts,tsx}", "!src/routeTree.gen.ts"],
  "ignore": ["src/routeTree.gen.ts", "drizzle-prod.config.ts"],
  "ignoreDependencies": [
    // Workspace source imports are followed by Knip but not credited as package usage.
    "@every-app/sdk",
    // Fulfills the SDK's required peer dependency.
    "jose",
    "tailwindcss",
    // Used via @plugin in CSS
    "daisyui",
  ],
  // Standard UI component patterns - keep full API surface for card.tsx
  "ignoreIssues": {
    "src/client/components/ui/card.tsx": ["exports"],
  },
}
