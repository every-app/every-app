{
  "entry": [
    // Detect Tanstack Start Routes
    "src/router.tsx",
    "src/routes/**/*.tsx",
    // Every App manifest and the Worker config built from it
    "everyapp.config.ts",
    "cloudflare.config.ts",
  ],
  "project": ["**/*.{js,ts,tsx}", "!src/routeTree.gen.ts"],
  "ignore": ["src/routeTree.gen.ts"],
  "ignoreDependencies": [
    // `cloudflare:workers` is a Workers runtime module that Knip reads as the
    // (unused) `cloudflare` npm package.
    "cloudflare",
    // Workspace source imports are followed by Knip but not credited as package usage.
    "@every-app/sdk",
    // Fulfills the SDK's required peer dependency.
    "jose",
    "tailwindcss",
    // Used via @plugin in CSS
    "daisyui",
  ],
  // Standard UI component patterns - keep full API surface for card.tsx
  "ignoreIssues": {
    "src/client/components/ui/card.tsx": ["exports"],
  },
}
