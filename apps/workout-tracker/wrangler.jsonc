{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "every-workout-tracker",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 3001,
  },
  "observability": {
    "enabled": true,
  },
  "services": [
    {
      "binding": "EVERY_APP_GATEWAY",
      "service": "every-app-gateway",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "aa59deac429a4cc687c58305c95eca3e",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "every-workout-tracker",
      "database_id": "25920432-a094-4122-86b4-326f12b4220e",
      "migrations_dir": "drizzle",
    },
  ],
}
