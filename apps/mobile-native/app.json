{
  "expo": {
    "name": "Every App",
    "slug": "gateway-mobile-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "everyapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/transparent-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0f0d"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.everyapp.gateway",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.everyapp.gateway",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1a1a1a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-updates"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "61acaee1-bf4d-4010-8779-6213eb8e7b21"
      }
    },
    "owner": "bensenescu",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/61acaee1-bf4d-4010-8779-6213eb8e7b21"
    }
  }
}
