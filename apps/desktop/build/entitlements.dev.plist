<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- V8 needs JIT and writable-executable memory under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- The microphone, for everyapp-helper (TCC charges its capture to Every App.app). System audio (the
       Core Audio process tap) needs no entitlement, only NSAudioCaptureUsageDescription. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Dev builds only: a self-signed or ad-hoc signature has no Team ID, so library validation
       would refuse to load Electron's frameworks. A Developer ID release doesn't need this. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
