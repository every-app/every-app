{
  "name": "everyapp-desktop",
  "productName": "Every App",
  "private": true,
  "version": "0.1.8",
  "description": "Every App for Mac: the desktop app (Scribe meeting notes first)",
  "author": "Every App",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "build": "electron-vite build",
    "types:check": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "package": "node scripts/release-helper.mjs && electron-vite build && electron-builder --config electron-builder.config.cjs --mac --dir",
    "package:local": "node scripts/package-local.mjs",
    "dist": "node scripts/release-helper.mjs && electron-vite build && electron-builder --config electron-builder.config.cjs --mac",
    "release": "bash scripts/release-mac.sh",
    "icons": "node scripts/make-icons.mjs",
    "check:icon": "node scripts/check-app-icon.mjs",
    "e2e": "playwright test",
    "deploy:updates": "wrangler deploy -c updates/wrangler.jsonc"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@every-app/desktop-ui": "workspace:*",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-router": "^1.170.46",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^0.542.0",
    "playwright": "1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=22"
  }
}
