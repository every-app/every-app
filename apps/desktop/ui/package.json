{
  "name": "@every-app/desktop-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/ui/*.tsx",
    "./screens": "./src/screens/index.ts",
    "./lib/*": "./src/lib/*.ts",
    "./styles.css": "./src/styles/app.css"
  },
  "scripts": {
    "playground": "vite --config playground/vite.config.ts",
    "build:playground": "vite build --config playground/vite.config.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "test": "vitest run",
    "types:check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.3",
    "lucide-react": "^0.542.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "playwright": "1.64.1",
    "prettier": "3.6.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
