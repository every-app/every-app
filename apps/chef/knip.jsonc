{
  "entry": [
    "src/types/index.ts",
    // Detect Tanstack Start Routes (including API routes)
    "src/router.tsx",
    "src/routes/**/*.{ts,tsx}",
    // Every App manifest and the Worker config built from it
    "everyapp.config.ts",
    "cloudflare.config.ts",
  ],
  "project": ["**/*.{js,mjs,ts,tsx}", "!src/routeTree.gen.ts"],
  "ignore": ["src/routeTree.gen.ts"],
  "ignoreDependencies": [
    // `cloudflare:workers` is a Workers runtime module that Knip reads as the
    // (unused) `cloudflare` npm package.
    "cloudflare",
    // Workspace source imports are followed by Knip but not credited as package usage.
    "@every-app/sdk",
    // Fulfills the SDK's required peer dependency.
    "jose",
    "tailwindcss",
    // Used via @plugin in CSS
    "daisyui",
  ],
  "ignoreIssues": {
    // Schema export needed for drizzle relational queries
    "src/db/index.ts": ["exports"],
  },
}
