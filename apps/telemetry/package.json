{
  "name": "everyapp-telemetry",
  "private": true,
  "version": "0.1.0",
  "description": "telemetry.everyapp.com: receives the daily usage report a Gateway sends",
  "type": "module",
  "scripts": {
    "types:check": "tsc --noEmit",
    "test": "vitest run",
    "deploy:worker": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply everyapp-telemetry --remote",
    "numbers": "wrangler d1 execute everyapp-telemetry --remote --file numbers.sql"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=22"
  }
}
