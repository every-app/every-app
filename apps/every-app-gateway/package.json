{
  "name": "every-app-gateway",
  "version": "0.0.25",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "types:check": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier . --write",
    "build": "vite build && tsc --noEmit",
    "build:debug": "DEBUG_BUILD=true vite build && tsc --noEmit",
    "start": "node .output/server/index.mjs",
    "deploy": "npm run db:migrate:prod && npm run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface Env",
    "auth:generate": "npx @better-auth/cli@1.4.6 generate --config src/auth/cli-config.ts --output src/db/auth.schema.ts -y",
    "auth:update": "pnpm run auth:generate",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "drizzle-kit migrate",
    "db:migrate:prod": "every app remote-d1-shell -- drizzle-kit migrate --config=drizzle-prod.config.ts",
    "db:studio:local": "drizzle-kit studio",
    "db:studio:prod": "every app remote-d1-shell -- drizzle-kit studio --config=drizzle-prod.config.ts",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.17.0",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/query-core": "^5.90.9",
    "@tanstack/query-db-collection": "^1.0.0",
    "@tanstack/query-sync-storage-persister": "^5.90.14",
    "@tanstack/react-db": "^0.1.44",
    "@tanstack/react-query": "^5.90.9",
    "@tanstack/react-query-persist-client": "^5.90.14",
    "@tanstack/react-router": "1.140.5",
    "@tanstack/react-router-devtools": "1.140.5",
    "@tanstack/react-start": "1.140.5",
    "better-auth": "^1.3.7",
    "cloudflare": "^5.2.0",
    "drizzle-orm": "^0.44.4",
    "jose": "^6.0.12",
    "lucide-react": "^0.540.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.62.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.11",
    "tiny-invariant": "^1.3.3",
    "vite-plugin-pwa": "^1.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251210.0",
    "@libsql/client": "^0.15.15",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.6.0",
    "daisyui": "^5.4.7",
    "drizzle-kit": "^0.31.4",
    "jsonc-parser": "^3.3.1",
    "knip": "^5.66.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "wrangler": "^4.53.0"
  }
}
