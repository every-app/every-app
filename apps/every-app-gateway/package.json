{
  "name": "every-app-gateway",
  "version": "0.2.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "types:check": "cf workers types && tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier . --write",
    "build": "cf build && tsc --noEmit",
    "build:debug": "DEBUG_BUILD=true cf build && tsc --noEmit",
    "start": "node .output/server/index.mjs",
    "auth:generate": "auth generate --config src/auth/cli-config.ts --output src/db/auth.schema.ts -y",
    "auth:check": "auth check schema --config src/auth/cli-config.ts",
    "auth:update": "pnpm run auth:generate",
    "secrets:regenerate": "node regenerate-secrets.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/cf-local.mjs migrate",
    "setup-link": "node scripts/setup-link.mjs",
    "db:studio:local": "drizzle-kit studio",
    "knip": "knip",
    "test": "vitest run --silent",
    "test:watch": "vitest",
    "build:release": "node scripts/build-release.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/expo": "1.7.7",
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@every-app/perimeter": "workspace:*",
    "@every-app/sdk": "workspace:*",
    "@every-app/toolbus": "workspace:*",
    "@tanstack/query-core": "^5.90.9",
    "@tanstack/query-db-collection": "^1.0.0",
    "@tanstack/query-sync-storage-persister": "^5.90.14",
    "@tanstack/react-db": "^0.1.44",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.90.9",
    "@tanstack/react-query-persist-client": "^5.90.14",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "lucide-react": "^0.540.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.4.0",
    "vite-plugin-pwa": "^1.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-91c870c02",
    "@cloudflare/workers-types": "^5.20260715.1",
    "@libsql/client": "^0.15.15",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.6.0",
    "auth": "1.7.7",
    "cf": "1.0.0-beta.14",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^20.14.6",
    "knip": "^5.66.4",
    "prettier": "^3.6.2",
    "shadcn": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.6"
  }
}
