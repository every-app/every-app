{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "every-app-gateway",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "kv_namespaces": [
    {
      "binding": "every-app-gateway",
      "id": "6d071b25ae8d40c481fc50bc12746753",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "every-app-gateway",
      "database_id": "2ec6dc01-2936-4753-b79b-6ee5625e8831",
      "migrations_dir": "drizzle",
    },
  ],
  // Rate limiting for sensitive endpoints
  // Period must be 10 or 60 seconds (Cloudflare limitation)
  "ratelimits": [
    {
      // Invitation/password reset: 10 attempts per 60 seconds per token
      "name": "RATE_LIMIT_AUTH_TOKEN",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
}
