{
  "entry": [
    // Worker config (cf dev, cf build) and the production Worker entry point
    "cloudflare.config.ts",
    "src/server.ts",
    // Detect Tanstack Start Routes
    "src/router.tsx",
    "src/routes/**/*.{ts,tsx}",
    // Better auth cli entrypoint
    "src/auth/index.ts",
    "scripts/*.{js,mjs,ts}",
    // shadcn components are copied in whole; pages use only some exports
    "src/client/components/ui/**",
  ],
  "project": ["**/*.{js,mjs,ts,tsx}", "!src/routeTree.gen.ts"],
  "ignore": ["src/routeTree.gen.ts", "src/auth/cli-config.ts"],
  "ignoreDependencies": [
    // `cloudflare:workers` is a Workers runtime module that Knip reads as the
    // (unused) `cloudflare` npm package.
    "cloudflare",
    // Workspace source imports are followed by Knip but not credited as package usage.
    "@every-app/cf-rest",
    "@every-app/perimeter",
    "@every-app/sdk",
    "@every-app/toolbus",
    // Used by vite during bundling
    "tailwindcss",
    // Imported by app.css; shadcn is also the component CLI
    "tw-animate-css",
    "shadcn",
  ],
}
