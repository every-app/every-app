{
  "entry": [
    // Detect Tanstack Start Routes
    "src/router.tsx",
    "src/routes/**/*.{ts,tsx}",
    // Better auth cli entrypoint
    "src/auth/index.ts",
  ],
  "project": ["**/*.{js,ts,tsx}", "!src/routeTree.gen.ts"],
  "ignore": [
    "src/routeTree.gen.ts",
    "drizzle-prod.config.ts",
    "regenerate-secrets.js",
  ],
  "ignoreDependencies": [
    "@tanstack/react-router-devtools",
    "daisyui",
    // Used by vite during bundling
    "tailwindcss",
  ],
  "ignoreBinaries": ["every"],
}
