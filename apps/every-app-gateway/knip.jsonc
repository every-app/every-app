{
  "ignoreBinaries": ["everyapp"],
  "entry": [
    // Production Worker entry point
    "src/server.ts",
    // Detect Tanstack Start Routes
    "src/router.tsx",
    "src/routes/**/*.{ts,tsx}",
    // Better auth cli entrypoint
    "src/auth/index.ts",
    "scripts/*.{js,mjs}",
  ],
  "project": ["**/*.{js,mjs,ts,tsx}", "!src/routeTree.gen.ts"],
  "ignore": [
    "src/routeTree.gen.ts",
    "drizzle-prod.config.ts",
    "src/auth/cli-config.ts",
  ],
  "ignoreDependencies": [
    // `cloudflare:workers` is a Workers runtime module that Knip reads as the
    // (unused) `cloudflare` npm package.
    "cloudflare",
    // Workspace source imports are followed by Knip but not credited as package usage.
    "@every-app/perimeter",
    "@every-app/sdk",
    // Deduped in vite.config.ts so the linked SDK signs identity JWTs with the
    // gateway's jose, not packages/sdk's devDependency copy.
    "jose",
    "daisyui",
    // Used by vite during bundling
    "tailwindcss",
  ],
}
