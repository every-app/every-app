{
  "extends": "../../tsconfig.base.json",
  "include": ["**/*.ts", "**/*.tsx", ".cloudflare/types/index.d.ts"],
  "exclude": ["node_modules", "release-package"],
  "compilerOptions": {
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "target": "ES2022",
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowImportingTsExtensions": true,
    "types": ["vite/client"]
  }
}
