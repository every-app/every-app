{
  "entry": [
    "everyapp.config.ts",
    "cloudflare.config.ts",
    "src/entry.worker.ts",
    "src/router.tsx",
    "src/routes/**/*.{ts,tsx}",
    // shadcn components are copied in whole; pages use only some of them.
    "src/client/components/ui/**",
    // Its BackButton is for the first page one level down.
    "src/client/components/PageHeader.tsx",
  ],
  "project": ["**/*.{ts,tsx}", "!src/routeTree.gen.ts"],
  "ignoreDependencies": [
    // Imported as @every-app/sdk/server, a subpath knip doesn't resolve in a linked package.
    "@every-app/sdk",
    // `cloudflare:workers` is the runtime's module, not the `cloudflare` package.
    "cloudflare",
    // The SDK's required peer dependency.
    "jose",
    // Loaded by @tailwindcss/vite from src/client/styles/app.css.
    "tailwindcss",
    // Imported by app.css.
    "tw-animate-css",
  ],
}
