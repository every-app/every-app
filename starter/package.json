{
  "name": "simple-todo-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "everyapp dev",
    "build": "vite build --mode development && tsc --noEmit",
    "deploy": "everyapp deploy",
    "test": "vitest run",
    "types:check": "cf workers types && tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier . --write",
    "db:generate": "drizzle-kit generate",
    "knip": "knip"
  },
  "dependencies": {
    "@every-app/sdk": "workspace:*",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.16",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-91c870c02",
    "@cloudflare/workers-types": "^4.20251014.0",
    "@libsql/client": "^0.15.15",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.18.13",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.6.0",
    "cf": "1.0.0-beta.14",
    "drizzle-kit": "^0.31.11",
    "everyapp": "workspace:*",
    "knip": "^5.66.4",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  }
}
