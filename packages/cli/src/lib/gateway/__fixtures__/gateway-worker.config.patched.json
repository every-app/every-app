{
  "name": "every-app-gateway",
  "compatibilityDate": "2025-09-02",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "assets": {
    "runWorkerFirst": true
  },
  "observability": {
    "enabled": true,
    "headSamplingRate": 1,
    "redactQueryString": true,
    "issues": {
      "enabled": true
    },
    "logs": {
      "enabled": true,
      "headSamplingRate": 1,
      "invocationLogs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "headSamplingRate": 0.1,
      "persist": true
    }
  },
  "workersDev": false,
  "previewUrls": false,
  "env": {
    "ASSETS": {
      "type": "assets"
    },
    "DB": {
      "type": "d1",
      "name": "every-app-gateway",
      "id": "11111111-2222-4333-8444-555555555555"
    },
    "OAUTH_KV": {
      "type": "kv",
      "id": "0123456789abcdef0123456789abcdef"
    },
    "EMAIL": {
      "type": "send-email"
    },
    "CF_VERSION_METADATA": {
      "type": "version-metadata"
    },
    "AUTH_RATE_LIMIT_IP": {
      "type": "rate-limit",
      "namespace": "4180",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    "AUTH_RATE_LIMIT_EMAIL": {
      "type": "rate-limit",
      "namespace": "4181",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    "AUTH_RATE_LIMIT_ACCOUNT": {
      "type": "rate-limit",
      "namespace": "4182",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    "GATEWAY_URL": {
      "type": "secret"
    },
    "BETTER_AUTH_SECRET": {
      "type": "secret"
    },
    "JWT_PRIVATE_KEY": {
      "type": "secret"
    },
    "JWT_PUBLIC_KEY": {
      "type": "secret"
    },
    "EVERYAPP_RELEASE": {
      "type": "json",
      "value": {
        "version": "0.2.0",
        "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      }
    },
    "APP_BASE_DOMAIN": {
      "type": "text",
      "value": "apps.example.com"
    },
    "APP__every-acme-chef": {
      "type": "worker",
      "worker": "every-acme-chef"
    },
    "APP__every-todo": {
      "type": "worker",
      "worker": "every-todo"
    }
  },
  "manifest": {
    "type": "partial",
    "mainModule": "index.js",
    "modules": {
      "assets/index-abc.js.map": {
        "type": "sourcemap"
      },
      "index.js.map": {
        "type": "sourcemap"
      }
    }
  },
  "domains": [
    "apps.example.com",
    "chef-acme.apps.example.com",
    "todo.apps.example.com"
  ]
}
