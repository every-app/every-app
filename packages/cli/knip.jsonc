{
  "entry": [
    // Published CLI binaries; their route maps dynamically import commands.
    "src/bin/*.ts",
    "src/commands/**/index.ts",
    "src/commands/*/command.ts",
  ],
  "ignoreDependencies": [
    // Workspace source imports are followed by Knip but not credited as package usage.
    "@every-app/cf-rest",
    "@every-app/perimeter",
    "@every-app/toolbus",
    // Run as a child process (lib/cf resolves its bin by path), never imported.
    "cf",
  ],
}
