{
  "entry": [
    // Published CLI binaries; their route maps dynamically import commands.
    "src/bin/*.ts",
    "src/commands/**/index.ts",
    "src/commands/*/command.ts",
    // The claude -p harnesses: run by hand with node (test/setup-skills/README.md,
    // test/build-skill/README.md), never imported; test/shared/ is what they share.
    "test/setup-skills/*.mjs",
    "test/setup-skills/stubs/*.mjs",
    "test/build-skill/*.mjs",
    "test/shared/*.mjs",
  ],
  "ignore": [
    // The starter template packed in at build (scripts/bundle-starter.mjs), gitignored.
    "starter/**",
    // Types for chat-secret.mjs, read by tsc through the src tests' import; knip follows no .mjs import to a .d.mts.
    "test/shared/chat-secret.d.mts",
  ],
  "ignoreDependencies": [
    // Workspace source imports are followed by Knip but not credited as package usage.
    "@every-app/perimeter",
    "@every-app/sdk",
    "@every-app/toolbus",
    // Run as a child process (lib/cf resolves its bin by path), never imported.
    "cf",
  ],
}
