{
  "name": "@every-app/sdk",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./internal": {
      "types": "./dist/internal/index.d.ts",
      "default": "./dist/internal/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare/index.d.ts",
      "default": "./dist/cloudflare/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "build:prepublish": "pnpm install --ignore-scripts && npm run types:check && npm run build",
    "prepublishOnly": "npm run build:prepublish",
    "types:check": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier . --write",
    "test": "vitest run --silent",
    "test:watch": "vitest",
    "check:esm-relative-imports": "node ./scripts/check-esm-relative-imports.mjs"
  },
  "peerDependencies": {
    "jose": "^6.2.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251014.0",
    "@types/node": "^22.18.13",
    "jose": "^6.2.12",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.6",
    "zod": "^4.2.0"
  }
}
