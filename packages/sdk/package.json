{
  "name": "@every-app/sdk",
  "private": true,
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./internal": {
      "types": "./dist/internal/index.d.ts",
      "default": "./dist/internal/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare/index.d.ts",
      "default": "./dist/cloudflare/index.js"
    },
    "./cloudflare/sentinel": {
      "types": "./dist/cloudflare/sentinel.d.ts",
      "default": "./dist/cloudflare/sentinel.js"
    },
    "./dev": {
      "types": "./dist/dev/index.d.ts",
      "default": "./dist/dev/index.js"
    },
    "./tanstack-start": {
      "types": "./dist/tanstack-start/index.d.ts",
      "default": "./dist/tanstack-start/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "types:check": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier . --write",
    "test": "vitest run --silent",
    "test:watch": "vitest",
    "check:esm-relative-imports": "node ./scripts/check-esm-relative-imports.mjs"
  },
  "dependencies": {
    "jose": "^6.2.5"
  },
  "peerDependencies": {
    "@tanstack/react-start": "^1.168.61"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251014.0",
    "@tanstack/react-start": "1.168.61",
    "@types/node": "^22.18.13",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.6",
    "zod": "^4.2.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-start": {
      "optional": true
    }
  }
}
