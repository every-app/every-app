{
  "name": "@every-app/sdk",
  "version": "0.1.6",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./tanstack": {
      "types": "./dist/tanstack/index.d.ts",
      "default": "./dist/tanstack/index.js"
    },
    "./tanstack/server": {
      "types": "./dist/tanstack/server/index.d.ts",
      "default": "./dist/tanstack/server/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare/index.d.ts",
      "default": "./dist/cloudflare/index.js"
    },
    "./cloudflare/server": {
      "types": "./dist/cloudflare/server/index.d.ts",
      "default": "./dist/cloudflare/server/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "types:check": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier . --write",
    "test": "vitest run --silent",
    "test:watch": "vitest"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "peerDependencies": {
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/react-start": "^1.0.0",
    "jose": "^6.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251014.0",
    "@tanstack/react-router": "^1.136.3",
    "@tanstack/react-start": "^1.136.3",
    "@types/node": "^22.18.13",
    "@types/react": "^19.0.8",
    "jose": "^6.0.12",
    "prettier": "^3.6.2",
    "react": "^19.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
