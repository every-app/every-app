{
  "entry": [
    // Every App manifest, Worker config and Worker entry point
    "everyapp.config.ts",
    "cloudflare.config.ts",
    "src/entry.worker.ts",
    "src/types/index.ts",
    // Detect Tanstack Start Routes
    "src/router.tsx",
    "src/routes/**/*.tsx",
    // Drizzle config (plugin disabled due to cloudflare:workers import issues)
    "drizzle.config.ts",
    // DB index re-exports schema for convenience
    "src/db/index.ts",
  ],
  "project": ["**/*.{js,ts,tsx}", "!src/routeTree.gen.ts"],
  "ignore": ["src/routeTree.gen.ts"],
  // Disable Drizzle plugin - it tries to load drizzle.config.ts which imports cloudflare:workers
  "drizzle": false,
  "ignoreDependencies": [
    // `cloudflare:workers` is a Workers runtime module that Knip reads as the
    // (unused) `cloudflare` npm package.
    "cloudflare",
    // Runtime Worker entry import; jose fulfills the SDK's required peer dependency.
    "@every-app/sdk",
    "jose",
    // Tailwindcss used via @tailwindcss/vite plugin
    "tailwindcss",
    "daisyui",
  ],
}
