{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "every-llm-chat",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 3001,
  },
  "assets": {
    "directory": ".output/public",
  },
  "observability": {
    "enabled": true,
  },
  "services": [
    {
      "binding": "EVERY_APP_GATEWAY",
      "service": "every-app-gateway",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "1c4de807508d4a0b8af107eac2e3ce98",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "every-llm-chat",
      "database_id": "f9724138-dd92-4a36-acbe-4ad96ce5639c",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [
    {
      "bucket_name": "every-llm-chat",
      "binding": "R2",
    },
  ],
}
