{
  // Detect Tanstack Start Routes
  "entry": [
    "src/types/index.ts",
    "src/router.tsx",
    "src/routes/**/*.{ts,tsx}",
    // Drizzle config (plugin disabled due to cloudflare:workers import issues)
    "drizzle.config.ts",
  ],
  "project": ["**/*.{js,ts,tsx}", "!src/routeTree.gen.ts"],
  "ignore": [
    "src/routeTree.gen.ts",
    "drizzle-prod.config.ts",
    "src/db/index.ts",
  ],
  // Disable Drizzle plugin - it tries to load drizzle.config.ts which imports cloudflare:workers
  "drizzle": false,
  "ignoreDependencies": ["tailwindcss", "daisyui"],
  "ignoreBinaries": ["every"],
  "ignoreIssues": {
    // Drizzle relation exports are needed for relational queries
    "src/db/schema.ts": ["exports"],
  },
}
