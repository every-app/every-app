{
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "postinstall": "pnpm -C packages/sdk build",
    "types:check": "pnpm -r --no-bail --parallel run types:check",
    "format:check": "pnpm -r --no-bail --parallel run format:check",
    "format:write": "pnpm -r --no-bail run format:write",
    "test": "pnpm -r --no-bail --parallel run test",
    "test:integration": "pnpm -r --no-bail --parallel run test:integration",
    "test:built-cli": "pnpm -C packages/sdk build && pnpm -C packages/cli build && pnpm -C packages/cli test:built",
    "knip": "pnpm -r --no-bail --parallel run knip",
    "pack-for-app": "node scripts/pack-for-app.mjs",
    "security-review": "node scripts/security-review.mjs",
    "release": "node scripts/release.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "e2e": "node scripts/e2e/run.mjs"
  },
  "devDependencies": {
    "everyapp": "workspace:*",
    "playwright": "1.64.1"
  }
}
