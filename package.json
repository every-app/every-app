{
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "postinstall": "pnpm -C packages/sdk build",
    "types:check": "pnpm -r --no-bail run types:check",
    "format:check": "pnpm -r --no-bail run format:check",
    "format:write": "pnpm -r --no-bail run format:write",
    "test": "pnpm -r --no-bail run test",
    "knip": "pnpm -r --no-bail run knip",
    "loop": "pnpm -C packages/onboarding-loop loop"
  },
  "devDependencies": {
    "everyapp": "workspace:*"
  }
}
