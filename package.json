{
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "postinstall": "pnpm -C packages/sdk build",
    "types:check": "pnpm -r --no-bail run types:check",
    "format:check": "pnpm -r --no-bail run format:check",
    "format:write": "pnpm -r --no-bail run format:write",
    "test": "pnpm -r --no-bail run test",
    "test:integration": "pnpm -r --no-bail run test:integration",
    "test:built-cli": "pnpm -C packages/sdk build && pnpm -C packages/cli build && pnpm -C packages/cli test:built",
    "knip": "pnpm -r --no-bail run knip",
    "loop": "pnpm -C packages/onboarding-loop loop",
    "public-copy": "node scripts/public-copy.mjs",
    "pack-for-app": "node scripts/pack-for-app.mjs",
    "security-review": "node scripts/security-review.mjs"
  },
  "devDependencies": {
    "everyapp": "workspace:*"
  }
}
